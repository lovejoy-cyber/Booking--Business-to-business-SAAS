# --- Database ---
# Any managed Postgres works: Neon, Supabase, Railway, RDS, etc.
DATABASE_URL="postgresql://user:password@host:5432/leadforge?schema=public"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Base URL of your deployment, no trailing slash
APP_URL="http://localhost:3000"

# --- AI provider ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."
AI_MODEL="claude-sonnet-4-6"

# --- Payments (optional — stubbed until you connect a real provider) ---
STRIPE_SECRET_KEY=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_WEBHOOK_SECRET=""
